  const LANG_COLORS = {
    JavaScript: '#f1e05a', TypeScript: '#3178c6', Python: '#3572A5', Java: '#b07219', Go: '#00ADD8',
    'C++': '#f34b7d', C: '#555555', 'C#': '#178600', Rust: '#dea584', Ruby: '#701516', PHP: '#4F5D95',
    Swift: '#F05138', Kotlin: '#A97BFF', Dart: '#00B4AB', Shell: '#89e051', HTML: '#e34c26', CSS: '#563d7c',
    SCSS: '#c6538c', Vue: '#41b883', Svelte: '#ff3e00', 'Jupyter Notebook': '#DA5B0B', Markdown: '#083fa1',
    'Objective-C': '#438eff', Scala: '#c22d40', Elixir: '#6e4a7e', Haskell: '#5e5086', Lua: '#000080',
    Clojure: '#db5855', Perl: '#0298c3', R: '#198CE7', Zig: '#ec915c', Vim: '#199f4b', 'Vim Script': '#199f4b',
    Dockerfile: '#384d54', MDX: '#fcb32c', 'Emacs Lisp': '#c065db', Julia: '#a270ba', Nix: '#7e7eff',
    TeX: '#3D6117', Assembly: '#6E4C13', MATLAB: '#e16737', PowerShell: '#012456', Makefile: '#427819',
    Astro: '#ff5a03', Solidity: '#AA6746', 'Classic ASP': '#6a40fd', Batchfile: '#C1F12E', OCaml: '#ef7a08',
