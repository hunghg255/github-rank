<%
  const fmt = (n) => Number(n || 0).toLocaleString('en-US');
  const displayName = user.name || user.login;
  const joined = user.created_at ? new Date(user.created_at) : null;
  const joinedText = joined ? `${joined.getFullYear()}/${String(joined.getMonth() + 1).padStart(2, '0')}/${String(joined.getDate()).padStart(2, '0')}` : '';
  const search = [user.login, user.name, user.location, user.company, city && city.label].filter(Boolean).join(' ').toLowerCase();
  const blog = user.blog ? (/^https?:\/\//i.test(user.blog) ? user.blog : `https://${user.blog}`) : '';
  const bio = String(user.bio || '').replace(/\s+/g, ' ').trim();
%>
<li class="row" data-search="<%= search %>"<% if (city) { %> data-city="<%= city.value %>"<% } %>>
  <div class="c-rank"><span class="rank rank-<%= idx + 1 %>"><%= idx + 1 %></span></div>
  <div class="c-user user">
    <a href="<%= user.html_url %>" target="_blank" rel="noopener" tabindex="-1">
      <img class="avatar" src="<%= user.avatar_url %>&s=80" width="40" height="40" loading="lazy" alt="">
    </a>
    <div class="user-name">
      <div class="user-title">
        <a href="<%= user.html_url %>" target="_blank" rel="noopener" title="<%= displayName %>"><%= displayName %></a>
        <% if (blog || user.twitter_username) { %>
        <span class="user-links">
          <% if (blog) { %><a href="<%= blog %>" target="_blank" rel="noopener nofollow" title="<%= user.blog %>" aria-label="Website"><svg width="12" height="12" aria-hidden="true"><use href="#i-link"></use></svg></a><% } %>
          <% if (user.twitter_username) { %><a href="https://x.com/<%= user.twitter_username %>" target="_blank" rel="noopener nofollow" title="@<%= user.twitter_username %> on X" aria-label="X profile"><svg width="12" height="12" aria-hidden="true"><use href="#i-x"></use></svg></a><% } %>
        </span>
        <% } %>
      </div>
      <span>@<%= user.login %></span>
      <% if (bio) { %><span class="bio" title="<%= bio %>"><%= bio %></span><% } %>
    </div>
  </div>
  <div class="c-location cell-text" title="<%= user.location || '' %>"><%= user.location || '—' %></div>
  <div class="c-company cell-text" title="<%= user.company || '' %>"><%= user.company || '—' %></div>
  <div class="c-followers r-num"><a class="stat stat-strong num" href="<%= user.html_url %>?tab=followers" target="_blank" rel="noopener"><%= fmt(user.followers) %></a></div>
  <div class="c-following r-num"><a class="stat num" href="<%= user.html_url %>?tab=following" target="_blank" rel="noopener"><%= fmt(user.following) %></a></div>
  <div class="c-repos r-num"><a class="stat num" href="<%= user.html_url %>?tab=repositories" target="_blank" rel="noopener"><%= fmt(user.public_repos) %></a></div>
  <div class="c-joined joined num"><%= joinedText %></div>
  <div class="c-meta"><% if (user.location) { %><span><svg width="12" height="12" aria-hidden="true"><use href="#i-location"></use></svg><b><%= user.location %></b></span><% } %><% if (user.company) { %><span><svg width="12" height="12" aria-hidden="true"><use href="#i-company"></use></svg><b><%= user.company %></b></span><% } %></div>
  <div class="c-stats">
    <a class="num" href="<%= user.html_url %>?tab=followers" target="_blank" rel="noopener"><%= fmt(user.followers) %> <span>followers</span></a>
    <a class="num" href="<%= user.html_url %>?tab=following" target="_blank" rel="noopener"><%= fmt(user.following) %> <span>following</span></a>
    <a class="num" href="<%= user.html_url %>?tab=repositories" target="_blank" rel="noopener"><%= fmt(user.public_repos) %> <span>repos</span></a>
  </div>
</li>
