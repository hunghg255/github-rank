  <button class="icon-btn to-top" type="button" aria-label="Back to top" title="Back to top">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3.47 7.78a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0l4.25 4.25a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018L9 4.81v7.44a.75.75 0 0 1-1.5 0V4.81L4.53 7.78a.75.75 0 0 1-1.06 0Z"></path></svg>
  </button>

  <script>
    (function () {
      var root = document.documentElement;

      // Theme toggle: explicit choice is remembered, otherwise follow the OS.
      var toggle = document.querySelector('.theme-toggle');
      toggle && toggle.addEventListener('click', function () {
        var current = root.getAttribute('data-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = current === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('gr-theme', next); } catch (e) {}
      });

      // Client-side filter: free-text search AND the active chip of each chip group.
      function fold(str) {
        return String(str || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');
      }
      var input = document.getElementById('search');
      var items = Array.prototype.slice.call(document.querySelectorAll('[data-search]'));
      var count = document.getElementById('count');
      var empty = document.getElementById('empty');
      var groups = Array.prototype.slice.call(document.querySelectorAll('[data-filter]'));
      var active = {};
      function flat(str) { return str.replace(/[\s.,_-]+/g, ''); }
      items.forEach(function (el) {
        el._text = fold(el.getAttribute('data-search'));
        el._flat = flat(el._text);
      });

      function apply() {
        var q = input ? fold(input.value.trim()) : '';
        var qFlat = flat(q);
        var visible = 0;
        items.forEach(function (el) {
          // "ha noi" should find "Hanoi", so also compare with separators removed.
          var match = !q || el._text.indexOf(q) !== -1 || (qFlat && el._flat.indexOf(qFlat) !== -1);
          for (var key in active) {
            if (active[key] && el.getAttribute('data-' + key) !== active[key]) match = false;
          }
          el.hidden = !match;
          if (match) visible++;
        });
        if (count) count.textContent = visible === items.length
          ? items.length.toLocaleString() + ' items'
          : visible.toLocaleString() + ' of ' + items.length.toLocaleString();
        if (empty) empty.style.display = visible ? 'none' : 'block';
      }

      groups.forEach(function (group) {
        var key = group.getAttribute('data-filter');
        group.addEventListener('click', function (e) {
          var chip = e.target.closest('.chip');
          if (!chip) return;
          active[key] = chip.getAttribute('data-value');
          group.querySelectorAll('.chip').forEach(function (c) {
            c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
          });
          apply();
        });
      });
      if (input) input.addEventListener('input', apply);
      apply();

      var top = document.querySelector('.to-top');
      if (top) {
        window.addEventListener('scroll', function () {
          top.classList.toggle('show', window.scrollY > 600);
        }, { passive: true });
        top.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      }
    })();
  </script>
</body>
